# 复制本文件为 ~/.workbuddy/media_keys.env 并填入真实 key
# 变量命名 MEDIA_<POOL>_<n>_KEY / _BASE / _POLL，序号必须连续

# ─── Agnes（内置模板之一，默认主力池） ───
export MEDIA_AGNES_1_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
export MEDIA_AGNES_1_BASE="https://apihub.agnes-ai.com/v1"
export MEDIA_AGNES_1_POLL="https://apihub.agnes-ai.com"

export MEDIA_AGNES_2_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
export MEDIA_AGNES_2_BASE="https://api.agnes-ai.cn/v1"
export MEDIA_AGNES_2_POLL="https://api.agnes-ai.cn"

export MEDIA_AGNES_3_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxx"
export MEDIA_AGNES_3_BASE="https://api.agnes-ai.cn/v1"
export MEDIA_AGNES_3_POLL="https://api.agnes-ai.cn"

# ─── 智谱（一级兜底：CogView 生图 / CogVideoX 视频） ───
export MEDIA_ZHIPU_1_KEY="your-zhipu-key"
export MEDIA_ZHIPU_1_BASE="https://open.bigmodel.cn/api/paas/v4"

# ─── 魔塔（首帧小改：Qwen-Image-Edit，仅 edit 子命令） ───
export MEDIA_MODELSCOPE_1_KEY="your-modelscope-key"
export MEDIA_MODELSCOPE_1_BASE="https://modelscope.cn/api/v1"

# ─── Key 角色（_ROLES，可选）──────────────────────
# 缺省 = image,video（一条龙：一把 key 包办生图+视频）
# 分工示例：A 家只画图、B 家只出视频：
#   export MEDIA_A_1_ROLES="image"
#   export MEDIA_B_1_ROLES="video"

# ─── 模型覆盖（可选，填模型名即换，零改码）──────────────
#   export MEDIA_AGNES_1_IMAGE_MODEL="agnes-image-2.2-flash"
#   export MEDIA_AGNES_1_VIDEO_MODEL="agnes-video-v3.0"

# ─── 全局优先级（可选）────────────────────────────
# 默认池与单命令跨池兜底顺序（未列出的池仍可 --provider 显式使用）：
#   export MEDIA_PRIORITY="agnes,zhipu"

# ─── 通用池（v2.7：任意 OpenAI 兼容渠道，纯 env 零改码） ───
# 序号递增多把：MEDIA_CUSTOM_2_... ；接哪个能力填哪个模型名，_ROLES 同步声明
# export MEDIA_CUSTOM_1_KEY="your-key"
# export MEDIA_CUSTOM_1_BASE="https://host/v1"
# export MEDIA_CUSTOM_1_ROLES="image"                        # 只接生图就只声明 image
# export MEDIA_CUSTOM_1_IMAGE_MODEL="flux-dev"               # 必填（该渠道没有默认模型名）
# export MEDIA_CUSTOM_1_IMAGE_SIZES="1024x1024,1344x768"     # 可选自填白名单（超出仅警告）
# export MEDIA_CUSTOM_1_VIDEO_MODEL="wan-2.3"                # 视频能力必填
# 视频默认按兼容网关风（/videos/generations 提交 + /videos/{id} 轮询）；
# Sora 风渠道：export MEDIA_CUSTOM_1_TASK_PATH="/videos"
# 注意：视频接口无行业标准，跑不通多半是风格族不对，按报错提示改 1-2 个路径参数

# ─── 旁白 TTS（可选，OpenAI 兼容 /audio/speech） ───
# export MEDIA_TTS_1_KEY="your-tts-key"
# export MEDIA_TTS_1_BASE="https://host/v1"
# export MEDIA_TTS_1_MODEL="cosyvoice-v1"
